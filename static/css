/* ==========================================================================
   Nova — design tokens
   Restrained, professional palette (near-black surface, single accent)
   instead of the multi-color neon-blob look — calmer, reads as a product
   rather than a demo.
   ========================================================================== */
:root {
  --bg: #0a0b0e;
  --bg-elevated: #101217;
  --surface: rgba(255, 255, 255, 0.035);
  --surface-hover: rgba(255, 255, 255, 0.06);
  --border: rgba(255, 255, 255, 0.09);
  --border-strong: rgba(255, 255, 255, 0.16);

  --text-primary: #f2f3f5;
  --text-secondary: #9aa0ac;
  --text-tertiary: #5f6570;

  --accent: #6d6bf9;
  --accent-hover: #7d7bfa;
  --accent-soft: rgba(109, 107, 249, 0.14);
  --accent-ring: rgba(109, 107, 249, 0.35);

  --success: #34d399;
  --danger: #f87171;
  --warning: #fbbf24;

  --radius-sm: 8px;
  --radius-md: 14px;
  --radius-lg: 20px;
  --radius-xl: 28px;

  --shadow-soft: 0 1px 2px rgba(0, 0, 0, 0.4);
  --shadow-elevated: 0 20px 50px -12px rgba(0, 0, 0, 0.55);

  --ease-out: cubic-bezier(0.16, 1, 0.3, 1);
  --ease-spring: cubic-bezier(0.34, 1.56, 0.64, 1);

  --font-sans: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
  --font-mono: 'JetBrains Mono', ui-monospace, monospace;
}

[data-theme="light"] {
  --bg: #f5f6f8;
  --bg-elevated: #ffffff;
  --surface: rgba(15, 15, 20, 0.03);
  --surface-hover: rgba(15, 15, 20, 0.06);
  --border: rgba(15, 15, 20, 0.09);
  --border-strong: rgba(15, 15, 20, 0.16);

  --text-primary: #16171b;
  --text-secondary: #565b66;
  --text-tertiary: #9198a3;

  --accent: #5451e0;
  --accent-hover: #4643c9;
  --accent-soft: rgba(84, 81, 224, 0.1);
  --accent-ring: rgba(84, 81, 224, 0.25);

  --shadow-elevated: 0 20px 50px -12px rgba(15, 15, 20, 0.18);
}

/* ==========================================================================
   Reset & base
   ========================================================================== */
* { box-sizing: border-box; margin: 0; padding: 0; }

html { color-scheme: dark; }
[data-theme="light"] html { color-scheme: light; }

body {
  background: var(--bg);
  color: var(--text-primary);
  font-family: var(--font-sans);
  min-height: 100vh;
  -webkit-font-smoothing: antialiased;
  transition: background-color 0.4s var(--ease-out), color 0.4s var(--ease-out);
  overflow-x: hidden;
}

button { font-family: inherit; }

::selection { background: var(--accent-soft); color: var(--accent); }

/* Subtle ambient backdrop — quiet, not a rave */
.backdrop {
  position: fixed;
  inset: 0;
  z-index: -1;
  background:
    radial-gradient(600px circle at 15% 20%, var(--accent-soft), transparent 60%),
    radial-gradient(500px circle at 85% 80%, rgba(52, 211, 153, 0.06), transparent 55%);
  pointer-events: none;
}

/* ==========================================================================
   Shell layout
   ========================================================================== */
.app-shell {
  max-width: 1080px;
  margin: 0 auto;
  padding: 1.5rem 1.5rem 3rem;
  min-height: 100vh;
  display: flex;
  flex-direction: column;
}

.topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0.5rem 0 2rem;
}

.brand {
  display: flex;
  align-items: center;
  gap: 0.65rem;
}

.brand-mark {
  width: 30px;
  height: 30px;
  border-radius: 9px;
  background: linear-gradient(135deg, var(--accent), #a78bfa);
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 700;
  font-size: 0.85rem;
  color: white;
  box-shadow: 0 4px 14px var(--accent-ring);
}

.brand-name {
  font-weight: 600;
  font-size: 1.05rem;
  letter-spacing: -0.01em;
}

.topbar-right { display: flex; align-items: center; gap: 0.75rem; }

.status-pill {
  display: inline-flex;
  align-items: center;
  gap: 0.45rem;
  padding: 0.35rem 0.7rem 0.35rem 0.55rem;
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: 100px;
  font-size: 0.75rem;
  color: var(--text-secondary);
  transition: border-color 0.3s;
}

.status-dot {
  width: 7px;
  height: 7px;
  border-radius: 50%;
  background: var(--text-tertiary);
  transition: background-color 0.3s, box-shadow 0.3s;
}

.status-dot.online { background: var(--success); box-shadow: 0 0 8px var(--success); }
.status-dot.offline { background: var(--danger); box-shadow: 0 0 8px var(--danger); }

.icon-btn {
  width: 34px;
  height: 34px;
  border-radius: var(--radius-sm);
  background: var(--surface);
  border: 1px solid var(--border);
  color: var(--text-secondary);
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  transition: all 0.2s var(--ease-out);
}

.icon-btn:hover { background: var(--surface-hover); color: var(--text-primary); border-color: var(--border-strong); }
.icon-btn svg { width: 16px; height: 16px; }

/* ==========================================================================
   Main grid
   ========================================================================== */
.main-grid {
  display: grid;
  grid-template-columns: minmax(0, 380px) minmax(0, 1fr);
  gap: 1.25rem;
  flex: 1;
  align-items: start;
}

@media (max-width: 860px) {
  .main-grid { grid-template-columns: 1fr; }
}

.panel {
  background: var(--bg-elevated);
  border: 1px solid var(--border);
  border-radius: var(--radius-xl);
  box-shadow: var(--shadow-elevated);
  animation: panelIn 0.6s var(--ease-out) both;
}

@keyframes panelIn {
  from { opacity: 0; transform: translateY(16px); }
  to { opacity: 1; transform: translateY(0); }
}

/* ---- Voice panel ---- */
.voice-panel {
  padding: 2rem 1.75rem 1.75rem;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}

.eyebrow {
  font-size: 0.7rem;
  font-weight: 600;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: var(--accent);
  margin-bottom: 0.5rem;
}

.voice-panel h1 {
  font-size: 1.4rem;
  font-weight: 650;
  letter-spacing: -0.01em;
  margin-bottom: 0.35rem;
}

.voice-panel .subtitle {
  color: var(--text-secondary);
  font-size: 0.875rem;
  margin-bottom: 1.75rem;
}

.orb-wrap {
  position: relative;
  width: 176px;
  height: 176px;
  margin-bottom: 1.5rem;
  display: flex;
  align-items: center;
  justify-content: center;
}

canvas#visualizer {
  position: absolute;
  inset: 0;
  width: 176px;
  height: 176px;
}

.mic-btn {
  position: relative;
  width: 92px;
  height: 92px;
  border-radius: 50%;
  background: var(--bg-elevated);
  border: 1.5px solid var(--border-strong);
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 2;
  transition: transform 0.35s var(--ease-spring), border-color 0.3s, background 0.3s;
}

.mic-btn:hover { transform: scale(1.05); border-color: var(--accent); }
.mic-btn:active { transform: scale(0.94); }

.mic-btn svg { width: 28px; height: 28px; fill: var(--text-primary); transition: fill 0.3s; }

.mic-btn.listening {
  background: var(--accent);
  border-color: var(--accent);
  animation: micPulse 1.6s infinite;
}
.mic-btn.listening svg { fill: white; }

.mic-btn.speaking { border-color: var(--success); }

@keyframes micPulse {
  0% { box-shadow: 0 0 0 0 var(--accent-ring); }
  70% { box-shadow: 0 0 0 20px rgba(109, 107, 249, 0); }
  100% { box-shadow: 0 0 0 0 rgba(109, 107, 249, 0); }
}

.mic-hint {
  font-size: 0.72rem;
  color: var(--text-tertiary);
  margin-bottom: 1.5rem;
}
kbd {
  font-family: var(--font-mono);
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: 4px;
  padding: 1px 5px;
  font-size: 0.68rem;
}

/* ---- Text fallback input ---- */
.type-row {
  width: 100%;
  display: flex;
  gap: 0.5rem;
  margin-bottom: 1rem;
}

.type-row input {
  flex: 1;
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: var(--radius-md);
  padding: 0.65rem 0.9rem;
  color: var(--text-primary);
  font-size: 0.875rem;
  outline: none;
  transition: border-color 0.2s, background 0.2s;
}
.type-row input:focus { border-color: var(--accent); background: var(--surface-hover); }
.type-row input::placeholder { color: var(--text-tertiary); }

.send-btn {
  width: 40px;
  border-radius: var(--radius-md);
  background: var(--accent);
  border: none;
  color: white;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: background 0.2s, transform 0.15s;
}
.send-btn:hover { background: var(--accent-hover); }
.send-btn:active { transform: scale(0.92); }
.send-btn svg { width: 16px; height: 16px; }

.voice-toggle-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  width: 100%;
  padding-top: 1rem;
  border-top: 1px solid var(--border);
  font-size: 0.8rem;
  color: var(--text-secondary);
}

.switch {
  position: relative;
  width: 36px;
  height: 20px;
  border-radius: 100px;
  background: var(--surface);
  border: 1px solid var(--border);
  cursor: pointer;
  transition: background 0.25s;
}
.switch.on { background: var(--accent); border-color: var(--accent); }
.switch::after {
  content: "";
  position: absolute;
  top: 2px; left: 2px;
  width: 14px; height: 14px;
  border-radius: 50%;
  background: white;
  transition: transform 0.25s var(--ease-spring);
}
.switch.on::after { transform: translateX(16px); }

/* ---- Conversation / activity panel ---- */
.activity-panel {
  padding: 1.5rem;
  display: flex;
  flex-direction: column;
  min-height: 480px;
  animation-delay: 0.1s;
}

.activity-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 1rem;
}

.activity-header h2 {
  font-size: 0.95rem;
  font-weight: 600;
}

.clear-btn {
  font-size: 0.75rem;
  color: var(--text-tertiary);
  background: none;
  border: none;
  cursor: pointer;
  transition: color 0.2s;
}
.clear-btn:hover { color: var(--text-primary); }

.log {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 0.6rem;
  overflow-y: auto;
  max-height: 360px;
  padding-right: 0.25rem;
  scrollbar-width: thin;
}
.log::-webkit-scrollbar { width: 5px; }
.log::-webkit-scrollbar-thumb { background: var(--border-strong); border-radius: 10px; }

.log-empty {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: var(--text-tertiary);
  font-size: 0.85rem;
  gap: 0.5rem;
  min-height: 220px;
}
.log-empty svg { width: 32px; height: 32px; opacity: 0.5; }

.entry {
  display: flex;
  flex-direction: column;
  gap: 0.3rem;
  padding: 0.75rem 0.9rem;
  border-radius: var(--radius-md);
  background: var(--surface);
  border: 1px solid var(--border);
  animation: entryIn 0.35s var(--ease-out) both;
}

@keyframes entryIn {
  from { opacity: 0; transform: translateY(8px); }
  to { opacity: 1; transform: translateY(0); }
}

.entry-row { display: flex; align-items: baseline; gap: 0.5rem; }
.entry-tag {
  font-size: 0.65rem;
  font-weight: 700;
  letter-spacing: 0.04em;
  text-transform: uppercase;
  padding: 1px 6px;
  border-radius: 4px;
  flex-shrink: 0;
}
.entry-tag.user { color: var(--text-secondary); background: var(--surface-hover); }
.entry-tag.nova { color: var(--accent); background: var(--accent-soft); }
.entry-text { font-size: 0.875rem; line-height: 1.4; }
.entry-time { margin-left: auto; font-size: 0.68rem; color: var(--text-tertiary); font-family: var(--font-mono); }
.entry.error .entry-tag.nova { color: var(--danger); background: rgba(248, 113, 113, 0.1); }

/* ---- Suggested commands ---- */
.chips-section { margin-top: 1.25rem; padding-top: 1.25rem; border-top: 1px solid var(--border); }
.chips-section h3 {
  font-size: 0.72rem;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.06em;
  color: var(--text-tertiary);
  margin-bottom: 0.7rem;
}
.chips { display: flex; flex-wrap: wrap; gap: 0.5rem; }
.chip {
  background: var(--surface);
  border: 1px solid var(--border);
  padding: 0.4rem 0.75rem;
  border-radius: 100px;
  font-size: 0.76rem;
  color: var(--text-secondary);
  cursor: pointer;
  transition: all 0.2s var(--ease-out);
  animation: chipIn 0.4s var(--ease-out) both;
}
.chip:hover { border-color: var(--accent); color: var(--text-primary); background: var(--accent-soft); transform: translateY(-1px); }
.chip:active { transform: translateY(0) scale(0.97); }

@keyframes chipIn {
  from { opacity: 0; transform: scale(0.9); }
  to { opacity: 1; transform: scale(1); }
}

/* ---- Footer stats ---- */
.footer-stats {
  display: flex;
  gap: 1.5rem;
  justify-content: center;
  margin-top: 2rem;
  font-size: 0.72rem;
  color: var(--text-tertiary);
  font-family: var(--font-mono);
}
.footer-stats span b { color: var(--text-secondary); font-weight: 600; }

/* ---- Toasts ---- */
.toast-stack {
  position: fixed;
  bottom: 1.5rem;
  left: 50%;
  transform: translateX(-50%);
  display: flex;
  flex-direction: column;
  gap: 0.5rem;
  z-index: 100;
  align-items: center;
}
.toast {
  background: var(--bg-elevated);
  border: 1px solid var(--border-strong);
  color: var(--text-primary);
  padding: 0.6rem 1rem;
  border-radius: var(--radius-md);
  font-size: 0.82rem;
  box-shadow: var(--shadow-elevated);
  animation: toastIn 0.35s var(--ease-spring) both;
}
.toast.warn { border-color: rgba(251, 191, 36, 0.4); }
.toast.error { border-color: rgba(248, 113, 113, 0.4); }

@keyframes toastIn {
  from { opacity: 0; transform: translateY(10px) scale(0.95); }
  to { opacity: 1; transform: translateY(0) scale(1); }
}
.toast.leaving { animation: toastOut 0.25s var(--ease-out) forwards; }
@keyframes toastOut { to { opacity: 0; transform: translateY(6px) scale(0.96); } }

/* Reduced motion */
@media (prefers-reduced-motion: reduce) {
  *, *::before, *::after { animation-duration: 0.001ms !important; animation-iteration-count: 1 !important; transition-duration: 0.001ms !important; }
  }
    
